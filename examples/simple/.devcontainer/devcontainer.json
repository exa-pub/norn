{
  "name": "norn-simple",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "initializeCommand": "mkdir -p \"${localEnv:INSTANCE_MNT_PATH:-.norn/mnt}\" \"${localEnv:DOTS_PATH:-.norn/dotfiles}\"",
  "mounts": [
    {
      "type": "bind",
      "source": "${localEnv:INSTANCE_MNT_PATH}",
      "target": "/home/vscode/mnt"
    },
    {
      "type": "bind",
      "source": "${localEnv:DOTS_PATH}",
      "target": "/home/vscode/dotfiles"
    }
  ],
  "postCreateCommand": "sh .devcontainer/postCreate.sh",
  "remoteEnv": {
    "WORKSPACE_FOLDER": "${containerWorkspaceFolder}"
  }
}
